AMC_EMAIL=your@email.com
AMC_PASSWORD="yourpassword"
CAPSOLVER_API_KEY=your_capsolver_key
# Optional: override the default Turnstile sitekey if AMC changes it
# AMC_SITEKEY=0x4AAAAAAA9oPHboisPr8cag

# Google OAuth — for Step 3 (get-ticket-email)
# Get these from Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Auto-filled after running: npm run auth-email
# GMAIL_REFRESH_TOKEN=
